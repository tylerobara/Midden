{
  "name": "@midden/server",
  "version": "0.1.0",
  "private": true,
  "description": "Midden server: Fastify + node:sqlite + WebSocket op log",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "midden": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "dev": "node --watch --no-warnings=ExperimentalWarning --experimental-transform-types --import ../../scripts/dev-ts.mjs src/main.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "load": "node --no-warnings=ExperimentalWarning scripts/load-ws.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@midden/core": "workspace:*",
    "fastify": "^5.12.5",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "oauth2-mock-server": "^9.2.0",
    "ws": "^8.21.3"
  }
}
